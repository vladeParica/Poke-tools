  "askTimeout": 300,
  "evolve": false,
  "stopOnShiny": true,
  "notify": null,

  "walkAxis": "horizontal",
  "walkFrames": 16,

  "healMode": "tile",          // curarse en la zona purificada del 5F (no hace falta la enfermera)
  "routeFile": "FRLG_TrainRoute_Tower.txt",
